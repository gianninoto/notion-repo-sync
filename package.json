{
  "name": "notion-repo-sync",
  "version": "0.1.0",
  "description": "Mirror a repo's markdown documents into Notion pages and databases — diff-driven, replace-not-merge, read back after every write. Extracted from the Manifest project's sync.",
  "type": "module",
  "bin": {
    "notion-repo-sync": "cli.mjs"
  },
  "exports": {
    ".": "./lib/index.mjs",
    "./extract": "./lib/extract.mjs",
    "./render": "./lib/render.mjs",
    "./api": "./lib/api.mjs"
  },
  "files": [
    "cli.mjs",
    "lib/",
    "skills/",
    ".claude-plugin/",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test 'tests/*.test.mjs'",
    "fixture:dry": "node cli.mjs --config fixtures/sample-project/notion-sync.config.mjs --dry-run",
    "fixture:check": "node cli.mjs --config fixtures/sample-project/notion-sync.config.mjs --check",
    "fixture:live": "node scripts/fixture-live.mjs"
  },
  "dependencies": {
    "@tryfabric/martian": "^1.2.4"
  },
  "license": "MIT"
}
